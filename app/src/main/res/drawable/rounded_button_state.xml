<?xml version="1.0" encoding="utf-8"?>
<!--
    Selector для кнопки "Создать" плейлист.

    Два состояния:
    - state_enabled="true" → синяя кнопка (активная)
    - state_enabled="false" → серая кнопка (неактивная)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Активное состояние (enabled=true) -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <!-- Синий цвет фона -->
            <solid android:color="@color/blue" />
            <!-- Скруглённые углы -->
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Неактивное состояние (enabled=false) -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <!-- Серый цвет фона -->
            <solid android:color="@color/gray" />
            <!-- Скруглённые углы -->
            <corners android:radius="8dp" />
        </shape>
    </item>

</selector>