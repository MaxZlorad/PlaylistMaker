<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_settings_color">

    <!-- RecyclerView для списка треков -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewFavoriteTracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:listitem="@layout/item_track"
        tools:visibility="visible" />

    <!-- Заглушка: LinearLayout с картинкой и текстом -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/placeholderImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="105dp"
            android:contentDescription="@string/empty_favourites_message"
            android:src="@drawable/error_search"
            android:visibility="visible" />

        <TextView
            android:id="@+id/placeholderMessage"
            style="@style/ErrorsTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:gravity="center"
            android:text="@string/empty_favourites_message"
            android:textColor="@color/black_white"
            android:textSize="@dimen/text_medium_max"
            android:visibility="visible" />

    </LinearLayout>

</FrameLayout>